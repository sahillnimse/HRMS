# Application
APP_NAME=HRMS AI
APP_ENV=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / Neon Lakebase Postgres)
# Pooled connection for app traffic; direct unpooled connection for Alembic migrations
DATABASE_URL=postgresql+asyncpg://hrms_user:hrms_pass@localhost:5432/hrms_db
DATABASE_URL_UNPOOLED=postgresql://hrms_user:hrms_pass@localhost:5432/hrms_db
DATABASE_URL_SYNC=postgresql+psycopg2://hrms_user:hrms_pass@localhost:5432/hrms_db

# AI Parser (Google Gemini API key OR OpenRouter sk-or-... key)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# File Storage ("local" for dev, "s3" or "r2" for Cloudflare R2 / S3)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx

# S3 / Cloudflare R2 (required only when STORAGE_BACKEND=s3 or STORAGE_BACKEND=r2)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=resumes

# Orphan pending resume cleanup
ORPHAN_MAX_AGE_HOURS=24
ORPHAN_CLEANUP_INTERVAL_MINUTES=60
ENABLE_CLEANUP_SCHEDULER=true

# Duplicate detection (pg_trgm fuzzy name threshold 0.0-1.0)
DUPLICATE_NAME_SIMILARITY_THRESHOLD=0.6

# Security & Auth (MUST be a 32+ char random secret in production)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional bootstrap admin user (created on startup if missing; leave blank after setup)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Admin

# CORS (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:5173"]
