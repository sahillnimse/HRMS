# Application
APP_NAME=HRMS AI
APP_ENV=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / Neon Lakebase Postgres)
# Pooled connection for app traffic; direct unpooled connection for Alembic migrations
DATABASE_URL=postgresql+asyncpg://hrms_user:hrms_pass@localhost:5432/hrms_db
DATABASE_URL_UNPOOLED=postgresql://hrms_user:hrms_pass@localhost:5432/hrms_db
DATABASE_URL_SYNC=postgresql+psycopg2://hrms_user:hrms_pass@localhost:5432/hrms_db

# AI Parser (Google Gemini API key OR OpenRouter sk-or-... key)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Semantic Search & Embeddings (auto-degrades gracefully if pgvector or Gemini key unavailable)
ENABLE_SEMANTIC_SEARCH=true
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Candidate Clarity, Brief & Timeline Checks (Phase 4)
ENABLE_CANDIDATE_BRIEF=true
CANDIDATE_BRIEF_TIMEOUT_SECONDS=25
TIMELINE_GAP_THRESHOLD_MONTHS=3
SHORT_STINT_MAX_MONTHS=12
EXPERIENCE_MISMATCH_YEARS_THRESHOLD=1.5

# Interview Workflow, Calendar & Email (Phase 5)
DEFAULT_TIMEZONE=Asia/Kolkata
CALENDAR_PROVIDER=ics
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hiring@hrms.local
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# Analytics Stuck-Stage Thresholds (Phase 6)
STUCK_APPLIED_DAYS=7
STUCK_SCREENED_DAYS=7
STUCK_INTERVIEW_DAYS=10
STUCK_OFFER_DAYS=7

# File Storage ("local" for dev, "s3" or "r2" for Cloudflare R2 / S3)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx

# S3 / Cloudflare R2 (required only when STORAGE_BACKEND=s3 or STORAGE_BACKEND=r2)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=resumes

# Orphan pending resume cleanup & candidate retention (Phase 0 & Phase 3)
ORPHAN_MAX_AGE_HOURS=24
ORPHAN_CLEANUP_INTERVAL_MINUTES=60
ENABLE_CLEANUP_SCHEDULER=true
# Days before candidate PII & resume files are purged (0 disables automatic purge)
RETENTION_DAYS=365

# Bulk upload & OCR fallback for scanned PDFs (Phase 3)
ENABLE_OCR_FALLBACK=true
OCR_MIN_TEXT_LENGTH=40
BULK_UPLOAD_MAX_FILES=25
# Optional Redis URL for ARQ workers; leave blank to use FastAPI BackgroundTasks
REDIS_URL=

# Duplicate detection (pg_trgm fuzzy name threshold 0.0-1.0)
DUPLICATE_NAME_SIMILARITY_THRESHOLD=0.6

# Security & Auth (MUST be a 32+ char random secret in production)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=hrms_refresh_token
# Leave blank to auto-enable Secure cookies in production and allow HTTP on localhost
REFRESH_COOKIE_SECURE=
REFRESH_COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Optional bootstrap admin user (created on startup if missing; leave blank after setup)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Admin

# CORS (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:5173"]
